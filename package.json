    "@types/d3": "^7.4.3",
    "@vercel/node": "^3.0.7",
    "@vercel/postgres": "^0.5.0",
    "axios": "^1.1.3",
    "d3": "^7.6.1",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "express-fileupload": "^1.4.0",
    "graphology": "^0.25.4",
    "graphology-types": "^0.24.7",
    "lodash": "^4.17.21",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^2.0.20",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
